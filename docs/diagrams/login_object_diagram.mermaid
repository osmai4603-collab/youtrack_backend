%% Object Diagram - Login Scenario for user "test1"  (POST /api/auth/login)
%% Mermaid version - renders on GitHub, VS Code, mermaid.live
%% Data source: migrations/000011_insert_users.up.sql, 000012_triggers.up.sql

flowchart TB

  subgraph S1["1. HTTP Request / Response DTOs"]
    direction TB
    oReq["<b>ParamsRequest</b><br/>handles/auth<br/>──────────<br/>username = test1<br/>password = ****<br/><i>ToLower+TrimSpace</i>"]
    oParams["<b>LoginParams</b><br/>usecases/auth<br/>──────────<br/>Username = test1<br/>Password = ****"]
    oUserParams["<b>userParams</b> nested DTO<br/>──────────<br/>id = test1<br/>login = test1<br/>email = test1@youtrack.local<br/>full_name = Test One<br/>display_name = Test One<br/>$type = User<br/>is_email_verified = true"]
    oRes["<b>ParamsResponse</b><br/>handles/auth<br/>──────────<br/>access_token = 9f3c1a7e..b41d2f<br/>refresh_token = 9f3c1a7e..b41d2f<br/>token_type = Cookie<br/>expires_in = 604800<br/>user_id = test1"]
    oCookie["<b>http.Cookie</b> client side<br/>──────────<br/>Name = youtrack_session<br/>Value = 9f3c1a7e..b41d2f<br/>Path = /<br/>MaxAge = 604800<br/>HttpOnly = true<br/>SameSite = Lax"]
  end

  subgraph S2["2. Domain Entities"]
    direction TB
    oUser["<b>:User</b> domain  (persisted)<br/>──────────<br/>id = test1<br/>login = test1<br/>email = test1@youtrack.local<br/>full_name = Test One<br/>name = test1<br/>avatar_url = /hub/api/rest/avatar/t1a..<br/>user_type_id = STANDARD_USER<br/>is_email_verified = true<br/>guest = false<br/>online = true<br/>banned = false<br/>can_read_profile = true<br/>is_locked = false<br/>password_hash = $2a$10$fZRjMe.6mx8/9x7zSqw..<br/>failed_login_count = 0<br/>last_failed_login_at = null<br/>last_login_at = null<br/>locked_until = null"]
    oState["<b>:LoginState</b> valueObject<br/>──────────<br/>FailedLoginCount = 0<br/>LastFailedLoginAt = null<br/>LastLoginAt = 2026-10-01T09:14Z<br/>LockedUntil = null<br/>IsLocked = false<br/><i>on success: count=0, LastLoginAt=now</i><br/><i>on 5th fail: locked 15m</i>"]
    oSession["<b>:UserSession</b> domain  (persisted)<br/>──────────<br/>ID = 9f3c1a7e..b41d2f<br/>SessionID = 9f3c1a7e..b41d2f<br/>Data = null<br/>UserID = test1<br/>CreatedAt = 2026-10-01T09:14Z<br/>UpdatedAt = 2026-10-01T09:14Z<br/>ExpiresAt = 2026-10-08T09:14Z"]
    oResult["<b>LoginResult</b> usecases/auth<br/>──────────<br/>User = :User<br/>Session = :UserSession<br/>Roles = [user]"]
    oUserType["<b>:UserType</b> user_types  (persisted)<br/>──────────<br/>id = STANDARD_USER<br/>name = Standard User"]
  end

  subgraph S3["3. Permissions / RBAC"]
    direction TB
    oScope["<b>:ScopeContext</b> valueObject<br/>──────────<br/>Type = ScopeGlobal<br/>ProjectID = (empty)<br/>OrganizationID = (empty)<br/>ResourceID = (empty)<br/><b>test1 has NO global role</b><br/>only project scope<br/>=> falls back to [user]"]
    oArT1a["<b>:RoleAssignment</b> ar-t1a<br/>──────────<br/>RoleID = project_member<br/>HolderType = user<br/>HolderID = test1<br/>ScopeType = project<br/>ScopeProjectID = proj-t1-a"]
    oArT1b["<b>:RoleAssignment</b> ar-t1b<br/>──────────<br/>RoleID = project_member<br/>HolderType = user<br/>HolderID = test1<br/>ScopeType = project<br/>ScopeProjectID = proj-t1-b"]
    oRolePM["<b>:Role</b> roles<br/>──────────<br/>ID = project_member<br/>Immutable = false<br/>read-project-basic<br/>read-issue<br/>create-issue<br/>update-issue"]
  end

  subgraph S4["4. Groups / Teams / Projects"]
    direction TB
    oGAll["<b>:UserGroup</b> all-users<br/>──────────<br/>all_users_group = true<br/><i>added by trigger 000012</i>"]
    oGT1A["<b>:UserGroup</b> grp-t1-a<br/>──────────<br/>name = T1A Project Members<br/>team_for_project_id = proj-t1-a"]
    oGT1B["<b>:UserGroup</b> grp-t1-b<br/>──────────<br/>name = T1B Project Members<br/>team_for_project_id = proj-t1-b"]
    oTeam1A["<b>:ProjectTeam</b> team-t1-a<br/>──────────<br/>name = T1A Project Team<br/>project_id = proj-t1-a"]
    oTeam1B["<b>:ProjectTeam</b> team-t1-b<br/>──────────<br/>name = T1B Project Team<br/>project_id = proj-t1-b"]
    oProj1A["<b>:Project</b> proj-t1-a<br/>──────────<br/>name = Test1 Project Alpha<br/>short_name = T1A<br/>leader_id = test1<br/>team_id = team-t1-a<br/>default_visibility_group_id = grp-t1-a"]
    oProj1B["<b>:Project</b> proj-t1-b<br/>──────────<br/>name = Test1 Project Beta<br/>short_name = T1B<br/>leader_id = test1<br/>team_id = team-t1-b<br/>default_visibility_group_id = grp-t1-b"]
  end

  subgraph S5["5. Layers / Repositories"]
    direction TB
    oHReq["http.Request"]
    oRouter["chi.Router"]
    oUC["<b>:AuthLoginUseCase</b><br/>──────────<br/>sessionTTL = 168h<br/>maxFailedLogins = 5<br/>lockDuration = 15m"]
    oUserRepo[":PostgresUserRepository"]
    oPermRepo[":PostgresPermissionRepository"]
    oSessRepo[":PostgresSessionRepository"]
    oRow["<b>sessions</b> table row<br/>──────────<br/>id = 9f3c1a7e..b41d2f<br/>session_id = 9f3c1a7e..b41d2f<br/>user_id = test1<br/>expires_at = 2026-10-08T09:14Z"]
  end

  %% --- request flow ---
  oHReq -->|POST /api/auth/login| oRouter
  oRouter -->|TryLogin| oUC
  oReq -.->|maps to| oParams

  %% --- repository access ---
  oUC -->|FindByLogin / UpdateLoginState| oUserRepo
  oUC -->|GetRolesByUserID ScopeGlobal| oPermRepo
  oUC -->|Create session| oSessRepo
  oUserRepo -->|SELECT FROM users| oUser
  oSessRepo -->|INSERT ON CONFLICT| oRow
  oRow ---|same row| oSession
  oPermRepo -.->|scope mismatch| oArT1a
  oPermRepo -.->|scope mismatch| oArT1b

  %% --- domain graph ---
  oParams -.->|reads| oUser
  oUser -.->|UPDATE| oState
  oParams -.->|GetRolesByUserID| oScope
  oParams -.->|RandomSessionID + Create| oSession
  oUser -->|user_type_id| oUserType
  oUser -->|holder_id| oArT1a
  oUser -->|holder_id| oArT1b
  oArT1a -->|role_id| oRolePM
  oArT1b -->|role_id| oRolePM
  oUser -->|UserID 1:N CASCADE| oSession

  %% --- result ---
  oUser --> oResult
  oSession --> oResult
  oResult -.->|userParams| oUserParams
  oUserParams --> oRes
  oResult -.->|Set-Cookie| oCookie
  oSession -->|Value = SessionID| oCookie

  %% --- groups / projects ---
  oUser -->|group_members| oGAll
  oUser -->|group_members| oGT1A
  oUser -->|group_members| oGT1B
  oUser -->|leader_id| oProj1A
  oUser -->|leader_id| oProj1B
  oUser -->|project_team_members| oTeam1A
  oUser -->|project_team_members| oTeam1B
  oProj1A -->|team_id| oTeam1A
  oProj1B -->|team_id| oTeam1B
  oProj1A -->|default_visibility_group_id| oGT1A
  oProj1B -->|default_visibility_group_id| oGT1B