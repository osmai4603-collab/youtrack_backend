oProj1B --> oTeam1B : team_id
oProj1A --> oGT1A : default_visibility_group_id
oProj1B --> oGT1B : default_visibility_group_id

' ---------- 11. Architecture context ----------
package "Presentation" {
  object "http.Request" as oHReq
  object "chi.Router" as oRouter
}

package "Application" {
  object ":AuthLoginUseCase" as oUC {
    sessionTTL = 168h
    maxFailedLogins = 5
    lockDuration = 15m
  }
}

package "Infrastructure" {
  object ":PostgresUserRepository" as oUserRepo
  object ":PostgresPermissionRepository" as oPermRepo
  object ":PostgresSessionRepository" as oSessRepo
}

oHReq --> oRouter : POST /api/auth/login
oRouter --> oUC : TryLogin(ctx, params)
oUC --> oUserRepo : FindByLogin / UpdateLoginState
oUC --> oPermRepo : GetRolesByUserID(ctx, "test1", ScopeGlobal)
oUC --> oSessRepo : Create(session)
oUserRepo --> oUser : SELECT FROM users
oSessRepo --> oRow : INSERT
oPermRepo ..> oArT1a : scope mismatch
oPermRepo ..> oArT1b : scope mismatch

@enduml